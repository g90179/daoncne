{
  "name": "daoncne",
  "compatibility_date": "2026-07-02",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rss.xml", "/rss"]
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "daoncne.co.kr/*", "zone_name": "daoncne.co.kr" },
    { "pattern": "www.daoncne.co.kr/*", "zone_name": "daoncne.co.kr" }
  ]
}
